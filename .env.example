# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLOUD_TIMEOUT_SECONDS=60

OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3:1.7b
LOCAL_TIMEOUT_SECONDS=120
LOCAL_NUM_CTX=4096
# Prompts (plus context) longer than this many characters are routed to the cloud.
LOCAL_MAX_INPUT_CHARS=6000

# Hard input limits enforced by the request processor.
MAX_PROMPT_CHARS=20000
MAX_CONTEXT_MESSAGES=10
